{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lodestar",
  "version": "0.1.0",
  "identifier": "com.lodestar.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lodestar",
        "width": 1100,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#e6eef7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Lodestar",
    "category": "Game",
    "shortDescription": "Minecraft server manager",
    "longDescription": "Create, run and reset Minecraft Java servers with managed Java, a live console and playit.gg public addresses.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
